rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

function isAdmin() {
  return signedIn() && request.auth.uid in [
    // Keep this list in sync with Vercel ADMIN_UIDS and src/utils/admin.js.
    "AjV7SA0tuzLOcizYBrbjH8Mo0fg1"
  ];
}

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function overrideDoc(uid) {
      return get(/databases/$(database)/documents/adminOverrides/$(uid));
    }

    function hasActiveOverride(uid) {
      return exists(/databases/$(database)/documents/adminOverrides/$(uid)) &&
        overrideDoc(uid).data.tier in ['free', 'pro'] &&
        (
          !('expiresAt' in overrideDoc(uid).data) ||
          overrideDoc(uid).data.expiresAt == null ||
          overrideDoc(uid).data.expiresAt > request.time
        );
    }

    function effectiveTier(uid) {
      return hasActiveOverride(uid)
        ? overrideDoc(uid).data.tier
        : (
          exists(/databases/$(database)/documents/users/$(uid)) &&
          userDoc(uid).data.tier in ['pro', 'business']
            ? 'pro'
            : 'free'
        );
    }

    function isPro(uid) {
      return effectiveTier(uid) == 'pro';
    }

    function inviteDoc(token) {
      return get(/databases/$(database)/documents/invites/$(token));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // What a user is paying for. Only an admin or the promo flow (which writes
    // an adminOverrides document, not this one) may set these.
    function billingFields() {
      return ['tier', 'subscriptionTier', 'stripeTier', 'promoCode',
              'promoTierExpiresAt', 'promoGrantedBy', 'promoGrantedAt'];
    }

    // What attaches an account to a manager's workspace, and therefore what
    // that account can read. Writable only when a real invite backs it.
    function linkFields() {
      return ['accountType', 'managerId', 'linkedEmployeeId'];
    }

    // An invite is single-use. The link and the claim are written in one batch,
    // so the invite as it will stand after the batch must name this account as
    // its user. Checking `used` alone was not enough: the claim used to be a
    // separate write that rules denied, so every invite stayed open forever and
    // anyone holding the link could attach to the same employee.
    function inviteBacksLink() {
      let token = request.resource.data.inviteToken;
      let after = getAfter(/databases/$(database)/documents/invites/$(token));
      return request.resource.data.accountType == 'employee' &&
        'inviteToken' in request.resource.data &&
        token is string &&
        exists(/databases/$(database)/documents/invites/$(token)) &&
        after.data.managerId == request.resource.data.managerId &&
        after.data.employeeId == request.resource.data.linkedEmployeeId &&
        after.data.get('used', false) == true &&
        after.data.get('usedBy', '') == request.auth.uid;
    }

    // The invitee marks their own invite used, once, in the same batch that
    // links their account to it.
    function isInviteClaim(inviteId) {
      return signedIn() &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('inviteToken', '') == inviteId &&
        resource.data.get('used', false) != true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']) &&
        request.resource.data.used == true &&
        request.resource.data.usedBy == request.auth.uid &&
        request.resource.data.usedAt == request.time;
    }

    function promoDoc(code) {
      return get(/databases/$(database)/documents/promoCodes/$(code));
    }

    function validPromoCode(code) {
      return code is string &&
        exists(/databases/$(database)/documents/promoCodes/$(code)) &&
        promoDoc(code).data.tier == 'pro' &&
        promoDoc(code).data.active == true &&
        (
          !('expiresAt' in promoDoc(code).data) ||
          promoDoc(code).data.expiresAt == null ||
          promoDoc(code).data.expiresAt > request.time
        ) &&
        (
          !('maxUses' in promoDoc(code).data) ||
          promoDoc(code).data.maxUses == null ||
          promoDoc(code).data.usedCount < promoDoc(code).data.maxUses
        );
    }

    function isPromoOverride(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['tier', 'expiresAt', 'reason', 'grantedBy', 'grantedAt', 'code']) &&
        request.resource.data.tier == 'pro' &&
        request.resource.data.grantedBy == 'promo-code' &&
        request.resource.data.reason == 'promo code ' + request.resource.data.code &&
        validPromoCode(request.resource.data.code) &&
        (
          request.resource.data.expiresAt == null ||
          request.resource.data.expiresAt <= request.time + duration.value(366, 'd')
        );
    }

    // The document being updated is the promo code itself, so it validates
    // against resource.data directly — no lookup, and no reference to the
    // match wildcard, which is not in scope inside a top-level function.
    function isPromoUseIncrement() {
      return signedIn() &&
        resource.data.tier == 'pro' &&
        resource.data.active == true &&
        (
          !('expiresAt' in resource.data) ||
          resource.data.expiresAt == null ||
          resource.data.expiresAt > request.time
        ) &&
        (
          !('maxUses' in resource.data) ||
          resource.data.maxUses == null ||
          resource.data.usedCount < resource.data.maxUses
        ) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1;
    }

    match /adminOverrides/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if (
        isAdmin() &&
          request.resource.data.tier in ['free', 'pro'] &&
          request.resource.data.keys().hasOnly(['tier', 'expiresAt', 'reason', 'grantedBy', 'grantedAt', 'code']) &&
          request.resource.data.grantedBy == request.auth.uid
      ) || isPromoOverride(uid);
      allow delete: if isAdmin();
    }

    match /promoCodes/{code} {
      // The code itself is the secret, so a direct lookup is fine but the
      // collection must not be listable.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isPromoUseIncrement();
    }

    match /employees/{employeeId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // The free-tier employee cap is enforced client-side in src/utils/tier.js;
      // rules cannot count documents in a collection.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /schedules/{scheduleId} {
      // Linked employees read schedules through /api/my-schedule, which cuts
      // each week down to their own shifts unless the manager allows the full
      // view. A direct read would hand them the whole team's week regardless.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // The free-tier generation quota is enforced client-side in src/utils/tier.js.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /invites/{inviteId} {
      // The token is the document id, so accepting an invite needs a direct
      // lookup. Listing would hand every signed-in user every open invite.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.managerId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.managerId == request.auth.uid &&
        isPro(request.auth.uid);
      allow update: if signedIn() &&
        (resource.data.managerId == request.auth.uid || isAdmin() || isInviteClaim(inviteId));
      allow delete: if signedIn() &&
        (resource.data.managerId == request.auth.uid || isAdmin());
    }

    // Written only by the server (Admin SDK bypasses rules). Readable by the
    // owner so the app can show remaining generations if we ever surface it.
    match /aiUsage/{docId} {
      allow read: if isAdmin() || (signedIn() && docId.split('_')[0] == request.auth.uid);
      allow write: if false;
    }

    // Server-side abuse counters. Written only by the Admin SDK, which bypasses
    // rules; a client that could read them would learn how close it is to a
    // limit, and one that could write them would erase the limit.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      // A manager reads the portal record of each employee linked to their
      // workspace: it is where those employees submit availability and time
      // off. Without this the manager's query was denied, the error swallowed,
      // and every employee submission silently never reached the schedule.
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (resource.data.get('accountType', '') == 'employee' &&
          resource.data.get('managerId', '') == request.auth.uid)
      );

      // A user owns their profile, availability and workspace settings, but not
      // their plan, and not the fields that point their account at a workspace.
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        !request.resource.data.keys().hasAny(billingFields()) &&
        (!request.resource.data.keys().hasAny(linkFields()) || inviteBacksLink())
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        !changedKeys().hasAny(billingFields()) &&
        (!changedKeys().hasAny(linkFields()) || inviteBacksLink())
      );

      // Erasure is a right, so a user can always remove their own record. The
      // full delete runs server-side through the Admin SDK, which bypasses
      // rules; this covers the direct case and makes the right explicit.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);

    }

  }
}
