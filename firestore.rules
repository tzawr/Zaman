rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

function isAdmin() {
  return signedIn() && request.auth.uid in [
    // Keep this list in sync with Vercel ADMIN_UIDS and src/utils/admin.js.
    "AjV7SA0tuzLOcizYBrbjH8Mo0fg1"
  ];
}

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function overrideDoc(uid) {
      return get(/databases/$(database)/documents/adminOverrides/$(uid));
    }

    function hasActiveOverride(uid) {
      return exists(/databases/$(database)/documents/adminOverrides/$(uid)) &&
        overrideDoc(uid).data.tier in ['free', 'pro'] &&
        (
          !('expiresAt' in overrideDoc(uid).data) ||
          overrideDoc(uid).data.expiresAt == null ||
          overrideDoc(uid).data.expiresAt > request.time
        );
    }

    function effectiveTier(uid) {
      return hasActiveOverride(uid)
        ? overrideDoc(uid).data.tier
        : (
          exists(/databases/$(database)/documents/users/$(uid)) &&
          userDoc(uid).data.tier in ['pro', 'business']
            ? 'pro'
            : 'free'
        );
    }

    function isPro(uid) {
      return effectiveTier(uid) == 'pro';
    }

    function inviteDoc(token) {
      return get(/databases/$(database)/documents/invites/$(token));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // What a user is paying for. Only an admin or the promo flow (which writes
    // an adminOverrides document, not this one) may set these.
    function billingFields() {
      return ['tier', 'subscriptionTier', 'stripeTier', 'promoCode',
              'promoTierExpiresAt', 'promoGrantedBy', 'promoGrantedAt'];
    }

    // What attaches an account to a manager's workspace, and therefore what
    // that account can read. Writable only when a real invite backs it.
    function linkFields() {
      return ['accountType', 'managerId', 'linkedEmployeeId'];
    }

    function inviteBacksLink() {
      return request.resource.data.accountType == 'employee' &&
        'inviteToken' in request.resource.data &&
        request.resource.data.inviteToken is string &&
        exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteToken)) &&
        inviteDoc(request.resource.data.inviteToken).data.managerId == request.resource.data.managerId &&
        inviteDoc(request.resource.data.inviteToken).data.employeeId == request.resource.data.linkedEmployeeId;
    }

    // An employee who joined a workspace through an invite can read that
    // workspace's schedules; the employee portal shows their own shifts from it.
    function isLinkedEmployeeOf(managerUid) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).data.accountType == 'employee' &&
        userDoc(request.auth.uid).data.managerId == managerUid;
    }

    function promoDoc(code) {
      return get(/databases/$(database)/documents/promoCodes/$(code));
    }

    function validPromoCode(code) {
      return code is string &&
        exists(/databases/$(database)/documents/promoCodes/$(code)) &&
        promoDoc(code).data.tier == 'pro' &&
        promoDoc(code).data.active == true &&
        (
          !('expiresAt' in promoDoc(code).data) ||
          promoDoc(code).data.expiresAt == null ||
          promoDoc(code).data.expiresAt > request.time
        ) &&
        (
          !('maxUses' in promoDoc(code).data) ||
          promoDoc(code).data.maxUses == null ||
          promoDoc(code).data.usedCount < promoDoc(code).data.maxUses
        );
    }

    function isPromoOverride(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['tier', 'expiresAt', 'reason', 'grantedBy', 'grantedAt', 'code']) &&
        request.resource.data.tier == 'pro' &&
        request.resource.data.grantedBy == 'promo-code' &&
        request.resource.data.reason == 'promo code ' + request.resource.data.code &&
        validPromoCode(request.resource.data.code) &&
        (
          request.resource.data.expiresAt == null ||
          request.resource.data.expiresAt <= request.time + duration.value(366, 'd')
        );
    }

    function isPromoUseIncrement() {
      return signedIn() &&
        validPromoCode(code) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1;
    }

    match /adminOverrides/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if (
        isAdmin() &&
          request.resource.data.tier in ['free', 'pro'] &&
          request.resource.data.keys().hasOnly(['tier', 'expiresAt', 'reason', 'grantedBy', 'grantedAt', 'code']) &&
          request.resource.data.grantedBy == request.auth.uid
      ) || isPromoOverride(uid);
      allow delete: if isAdmin();
    }

    match /promoCodes/{code} {
      // The code itself is the secret, so a direct lookup is fine but the
      // collection must not be listable.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isPromoUseIncrement();
    }

    match /employees/{employeeId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // The free-tier employee cap is enforced client-side in src/utils/tier.js;
      // rules cannot count documents in a collection.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isLinkedEmployeeOf(resource.data.userId)
      );
      // The free-tier generation quota is enforced client-side in src/utils/tier.js.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /invites/{inviteId} {
      // The token is the document id, so accepting an invite needs a direct
      // lookup. Listing would hand every signed-in user every open invite.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.managerId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.managerId == request.auth.uid &&
        isPro(request.auth.uid);
      allow update, delete: if signedIn() &&
        (resource.data.managerId == request.auth.uid || isAdmin());
    }

    // Written only by the server (Admin SDK bypasses rules). Readable by the
    // owner so the app can show remaining generations if we ever surface it.
    match /aiUsage/{docId} {
      allow read: if isAdmin() || (signedIn() && docId.split('_')[0] == request.auth.uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // A user owns their profile, availability and workspace settings, but not
      // their plan, and not the fields that point their account at a workspace.
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        !request.resource.data.keys().hasAny(billingFields()) &&
        (!request.resource.data.keys().hasAny(linkFields()) || inviteBacksLink())
      );
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        !changedKeys().hasAny(billingFields()) &&
        (!changedKeys().hasAny(linkFields()) || inviteBacksLink())
      );
    }
  }
}
