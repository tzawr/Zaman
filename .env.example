# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Browser config (public by design) ---------------------------------------
# Vite inlines every VITE_-prefixed variable into the client bundle, so ONLY
# public values may carry this prefix. The Firebase web config is meant to be
# public; what protects the data is firestore.rules, not the secrecy of these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Server secrets (never VITE_-prefixed) -----------------------------------
# Read with process.env inside api/. Prefixing any of these with VITE_ would
# ship them to every visitor.
ANTHROPIC_API_KEY=

# Firebase Admin credentials. Supply ONE of these three forms:
#   1. the whole service-account JSON, base64-encoded
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
#   2. the whole service-account JSON, verbatim
# FIREBASE_SERVICE_ACCOUNT_KEY=
#   3. the three fields separately
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Comma-separated Firebase Auth UIDs allowed to reach the admin endpoints.
# Keep in sync with src/utils/admin.js and the isAdmin() list in firestore.rules.
ADMIN_UIDS=

# Origin used to build verification links. Must be https and bare (no path).
APP_URL=https://hengam.app
