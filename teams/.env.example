# Copy to .env.local. Every value here is public by design: EXPO_PUBLIC_
# variables are compiled into the app. What protects data is firestore.rules.

# Firebase web config for the shared Hengam project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Where the Teams endpoints live. Production: https://hengam.app
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001

# Set to 1 to use the local Auth and Firestore emulators (npm run dev:emulators
# at the repo root). Requires EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-hengam.
EXPO_PUBLIC_USE_EMULATORS=

# Native Google sign-in. From the Firebase console: the web client id, and the
# iOS client's reversed id (com.googleusercontent.apps....). Leave empty to
# hide Google sign-in in the native apps; it always works on the web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Sign in with Apple on the web needs an Apple Services ID set up in Firebase.
# It is always offered on iOS.
EXPO_PUBLIC_APPLE_WEB=
