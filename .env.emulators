# Used by `vite --mode emulators` only. Demo values for the local Firebase
# emulators; nothing here reaches a real project.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hengam.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-hengam
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=1
VITE_TEAMS_APP_URL=http://localhost:8081
